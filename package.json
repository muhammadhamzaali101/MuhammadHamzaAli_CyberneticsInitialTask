{
  "name": "cybernetics-initial-task",  
  "version": "1.0.0",
  "description": "A test automation framework using cypress and cucumber",
  "keywords": [],
  "license": "ISC",
  "author": "muhammad Hamza Ali",
  "type": "commonjs",
  "main": "cypress.config.js",
  "scripts": {
    "test": "cypress run",
    "cy:chrome:headless": "cypress run --browser chrome --headless",
    "cy:edge:headless": "cypress run --browser edge --headless",
    "cy:electron:headless": "cypress run --browser electron --headless",
    "cy:chrome": "cypress open --browser chrome",
    "cy:edge": "cypress open --browser edge",
    "cy:electron": "cypress open --browser electron",
    "report": "mochawesome-merge cypress/reports/*.json > cypress/reports/merged-report.json && mochawesome-report-generator cypress/reports/merged-report.json"
  
  },
  
  "devDependencies": {
  "@badeball/cypress-cucumber-preprocessor": "^21.0.3",
  "@bahmutov/cypress-esbuild-preprocessor": "^2.2.4",
  "@shelex/cypress-allure-plugin": "^2.40.2",
  "allure-commandline": "^2.32.0",
  "cucumber-html-reporter": "^6.0.0",
  "cypress": "^13.17.0",
  "cypress-mochawesome-reporter": "^3.8.2",
  "cypress-plugin-api": "^2.11.2",
  "mochawesome": "^7.1.3",
  "mochawesome-merge": "^4.3.0",
  "mochawesome-report-generator": "^6.2.0" 
  },
  
  "cypress-cucumber-preprocessor": {
    "step_definitions": "cypress/support/step_definitions/",
    "nonGlobalStepDefinitions": false
    
  },
  
  "dependencies": {
    "axios": "^1.7.9"
  }
}
